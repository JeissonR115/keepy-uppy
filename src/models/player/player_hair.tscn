[sub_resource type="Shader" id="Shader_outline"]
code = "shader_type canvas_item;
uniform vec4 outline_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);
void fragment() {
	vec4 center = texture(TEXTURE, UV);
	float neighbor = 0.0;
	vec2 pixel = TEXTURE_PIXEL_SIZE;
	neighbor = max(neighbor, texture(TEXTURE, UV + vec2(pixel.x, 0.0)).a);
	neighbor = max(neighbor, texture(TEXTURE, UV - vec2(pixel.x, 0.0)).a);
	neighbor = max(neighbor, texture(TEXTURE, UV + vec2(0.0, pixel.y)).a);
	neighbor = max(neighbor, texture(TEXTURE, UV - vec2(0.0, pixel.y)).a);
	COLOR = center.a > 0.0 ? center : vec4(outline_color.rgb, neighbor * outline_color.a);
}"

